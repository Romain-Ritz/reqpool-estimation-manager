# =====================================================================
# .gitignore - Python Standard + Projekt-spezifisch
# =====================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Distribution / Packaging ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
venv/
env/
ENV/
.venv/
.env

# --- IDEs / Editoren ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Testing / Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Streamlit ---
.streamlit/secrets.toml

# --- Projekt-spezifisch ---
# Persistierte Schaetzungen sollen NICHT eingecheckt werden
data/estimations.json
# Aber das data-Verzeichnis selbst bleibt (mit .gitkeep)
!data/.gitkeep

# Lokale PDF-Exporte
*.pdf
!**/docs/**/*.pdf
